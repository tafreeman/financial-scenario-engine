{
  "name": "financial-scenario-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic financial scenario engine with optional LLM intent parsing — GitHub Models API or Ollama, local SQLite",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:pages": "cd client && npm run build:pages",
    "start": "tsx server/index.ts",
    "setup": "npm run install:all && npm run build",
    "lint": "npx eslint .",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "npx tsc --noEmit -p tsconfig.json",
    "typecheck:client": "cd client && npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval:intent": "tsx server/evals/run-intent-eval.ts",
    "eval:faithfulness": "tsx server/evals/run-faithfulness-eval.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "multer": "^2.2.0",
    "open": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^10.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "tmp": ">=0.2.6",
    "shell-quote": ">=1.8.4"
  }
}
