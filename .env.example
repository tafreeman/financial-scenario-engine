# Financial Scenario Engine — environment variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored; only this .env.example template is tracked (see .gitignore).
# Every var below is read via process.env in server/ and server/evals/ — see the
# cited file:line for the exact usage.

# GitHub Models API token for LLM intent parsing/narration (server/ai.ts) and the
# intent-eval harness (server/evals/run-intent-eval.ts). Token resolution order:
#   1. the app's SQLite "github_pat" config value (set in the Settings UI)
#   2. this GITHUB_TOKEN environment variable
#   3. your local GitHub CLI login (`gh auth token`), used automatically as a
#      zero-config fallback — so if you've run `gh auth login`, the GitHub
#      provider works without setting anything here.
# If none resolve, the GitHub provider is unavailable (use Ollama instead — see
# below). Any GitHub token needs the `models:read` permission. Set
# FSE_DISABLE_GH_TOKEN=1 to opt out of the gh-CLI fallback.
GITHUB_TOKEN=

# OpenRouter API key for LLM intent parsing/narration when llm_provider is
# "openrouter" (server/ai.ts resolveOpenRouterKey()) and for the intent-eval
# harness's OpenRouter path (server/evals/configure-openrouter-eval.ts). Token
# resolution order:
#   1. the app's SQLite "openrouter_api_key" config value (Settings UI does
#      not yet have a picker for this provider — set it via PUT /api/config)
#   2. this OPENROUTER_API_KEY environment variable
# If neither resolves, the OpenRouter provider is unavailable (use GitHub
# Models or Ollama instead).
OPENROUTER_API_KEY=

# Optional OpenRouter model override for the intent-eval CI job only
# (server/evals/configure-openrouter-eval.ts) — omit to use the script's
# default (nvidia/nemotron-3-ultra-550b-a55b:free, DEFAULT_OPENROUTER_MODEL in
# server/ai.ts). Not read anywhere outside that eval-configuration script; the
# app itself resolves its OpenRouter model from the DB "openrouter_model"
# config key, not from this env var.
OPENROUTER_MODEL=

# Shared secret required in the x-app-token header for mutating API routes
# (server/auth.ts:26). If unset, a random 256-bit token is generated at
# startup and printed to the console ONCE — set this explicitly for CI/scripts
# that need a stable, known token across restarts.
APP_API_TOKEN=

# Filesystem path to the SQLite database file (server/db.ts:8). Defaults to
# <repo>/data/finimpact.db. Override to point at an isolated DB, e.g. ":memory:"
# for tests.
DB_PATH=

# HTTP port the server listens on (server/index.ts:11). Defaults to 3000.
PORT=3000

# Host/interface the server binds to (server/index.ts:12). Defaults to
# 127.0.0.1 (localhost-only); set to 0.0.0.0 to accept connections from other
# hosts.
HOST=127.0.0.1

# Standard Node environment flag (server/index.ts:13). Set to "production" to
# disable dev-only behavior (e.g. auto-opening a browser tab); anything else
# is treated as development.
NODE_ENV=development

# Allowed CORS origin for the API (server/index.ts:22-32). Defaults to the
# Vite dev server origins (http://localhost:5173, http://127.0.0.1:5173).
# Set to your deployed frontend's exact origin in production.
# NOTE: the wildcard value "*" is refused at startup as a critical
# misconfiguration — always set an explicit origin.
CORS_ORIGIN=

# Opt-in flag for the intent-eval harness (server/evals/run-intent-eval.ts):
# when "1" or "true", an unconfigured LLM provider (checked via the same
# isProviderConfigured() production uses — github/ollama/openrouter, whichever
# is configured) is treated as a FATAL error instead of a silent skip, and the
# observed accuracy is gated against the committed threshold in
# server/evals/eval-config.ts. Intended for CI/gated runs; leave unset for
# local/dev runs where an unconfigured provider should just skip.
EVAL_INTENT_GATED=
